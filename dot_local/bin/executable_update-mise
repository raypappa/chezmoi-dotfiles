#!/usr/bin/env zsh
set -e
export GITHUB_TOKEN=$(gh auth token)
export DEBIAN_FRONTEND=noninteractive
if command -v sudo >/dev/null 2>&1; then
  sudo -v
fi
if command -v sudo >/dev/null 2>&1 && command -v apt >/dev/null 2>&1; then
  sudo apt update -q
  sudo apt upgrade -q -y
fi
if [[ -n "${WSL_DISTRO_NAME:-}" ]] || grep -qi microsoft /proc/version; then
  if command -v pwsh.exe >/dev/null 2>&1; then
    pwsh.exe -NoProfile -Command '$log = Join-Path $env:TEMP "windows-package-upgrade.log"; $script = "winget upgrade -h --all --accept-source-agreements --accept-package-agreements --disable-interactivity *> `"$log`"; `$wingetExit = `$LASTEXITCODE; choco upgrade -y all *>> `"$log`"; `$chocoExit = `$LASTEXITCODE; if (`$wingetExit -ne 0) { exit `$wingetExit }; exit `$chocoExit"; $encoded = [Convert]::ToBase64String([Text.Encoding]::Unicode.GetBytes($script)); $process = Start-Process pwsh.exe -Verb RunAs -Wait -PassThru -ArgumentList "-NoProfile -EncodedCommand $encoded"; Get-Content $log; exit $process.ExitCode'
  fi
fi
if command -v brew >/dev/null 2>&1; then
  brew update
  brew upgrade -y
fi
if command -v docker >/dev/null 2>&1 && docker desktop --help >/dev/null 2>&1; then
  docker desktop update
fi
if command -v omz >/dev/null 2>&1; then
  omz update
fi
mise self-update -y --silent
# mise lock --upgrade --global
mise up --bump --silent -y uv aqua cargo-binstaller rust go node ruby
mise up --silent -y
if [[ -d ~/.git-extras ]]; then
  git -C ~/.git-extras pull
  (cd ~/.git-extras && PREFIX=~/.local make install)
  if [ ! -e ~/.config/zsh.d/51-git-extras-completion.zsh ];then
    ln -s ~/.git-extras/etc/git-extras-completion.zsh ~/.config/zsh.d/51-git-extras-completion.zsh
  fi
fi
[[ -d ~/.git-plugins ]] && git -C ~/.git-plugins pull
[[ -d ~/.oh-my-zsh/custom/plugins/zsh-autosuggestions ]] && git -C ~/.oh-my-zsh/custom/plugins/zsh-autosuggestions pull
if command -v gcloud >/dev/null 2>&1;then
  gcloud components update --quiet
fi
