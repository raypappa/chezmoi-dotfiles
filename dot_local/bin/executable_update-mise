#!/usr/bin/env zsh
set -e
export GITHUB_TOKEN=$(gh auth token)
export DEBIAN_FRONTEND=noninteractive
if command -v sudo >/dev/null 2>&1; then
  sudo -v
fi
if command -v sudo >/dev/null 2>&1 && command -v apt >/dev/null 2>&1; then
  sudo apt update -q
  sudo apt upgrade -q -y
fi
if command -v brew >/dev/null 2>&1; then
  brew update
  brew upgrade -y
fi
if command -v omz >/dev/null 2>&1; then
  omz update
fi
mise self-update -y --silent
# mise lock --upgrade --global
mise up --bump --silent -y uv aqua cargo-binstaller rust go node ruby
mise up --silent -y
if [[ -d ~/.git-extras ]]; then
  git -C ~/.git-extras pull
  (cd ~/.git-extras && PREFIX=~/.local make install)
  if [ ! -e ~/.config/zsh.d/51-git-extras-completion.zsh ];then
    ln -s ~/.git-extras/etc/git-extras-completion.zsh ~/.config/zsh.d/51-git-extras-completion.zsh
  fi
fi
[[ -d ~/.git-plugins ]] && git -C ~/.git-plugins pull
[[ -d ~/.oh-my-zsh/custom/plugins/zsh-autosuggestions ]] && git -C ~/.oh-my-zsh/custom/plugins/zsh-autosuggestions pull
if command -v gcloud >/dev/null 2>&1;then
  gcloud components update --quiet
fi
